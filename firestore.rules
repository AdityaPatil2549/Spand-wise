rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isHouseholdMember(householdId) {
      return isAuthenticated() && (
        householdId == request.auth.uid ||
        (exists(/databases/$(database)/documents/households/$(householdId)) &&
         request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members)
      );
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // ── Users ──────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid);

      // Legacy user-scoped scheduled transactions (migration compatibility)
      match /scheduled_transactions/{scheduleId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ── Households ─────────────────────────────────────────────────
    match /households/{householdId} {
      allow create: if isAuthenticated() && (
        householdId == request.auth.uid ||
        (request.resource.data.members is list && request.auth.uid in request.resource.data.members)
      );
      allow read, update, delete: if isHouseholdMember(householdId);

      // Monthly aggregated budget & category caps
      match /budgets/{monthId} {
        allow read, write: if isHouseholdMember(householdId);
      }

      // Expenses ledger
      match /expenses/{expenseId} {
        allow read: if isHouseholdMember(householdId);

        allow create: if isHouseholdMember(householdId)
          && hasRequiredFields(['amount', 'categoryId', 'month', 'date', 'isDeleted'])
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount <= 1000000
          && request.resource.data.isDeleted == false
          && request.resource.data.month is string
          && request.resource.data.month.matches('^[0-9]{4}-[0-9]{2}$');

        allow update: if isHouseholdMember(householdId)
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount <= 1000000;

        allow delete: if isHouseholdMember(householdId);
      }

      // Categories
      match /categories/{categoryId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update: if isHouseholdMember(householdId)
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40;
        allow delete: if isHouseholdMember(householdId);
      }

      // Wallets / Accounts
      match /accounts/{accountId} {
        allow read: if isHouseholdMember(householdId);
        allow create, update: if isHouseholdMember(householdId)
          && request.resource.data.balance is number;
        allow delete: if isHouseholdMember(householdId);
      }

      // Savings Goals
      match /goals/{goalId} {
        allow read, write: if isHouseholdMember(householdId);
      }

      // Scheduled Transactions & Subscriptions
      match /scheduled_transactions/{scheduleId} {
        allow read, write: if isHouseholdMember(householdId);
      }

      // Splitwise Groups & Shared Split Expenses
      match /split_groups/{groupId} {
        allow read, write: if isHouseholdMember(householdId);
      }

      match /split_expenses/{splitExpenseId} {
        allow read, write: if isHouseholdMember(householdId);
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
